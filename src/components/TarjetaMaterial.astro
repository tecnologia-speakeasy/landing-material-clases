---
import { estaDisponible, type Material } from '@/lib/materiales';

interface Props {
  material: Material;
  /** Las primeras tarjetas cargan su miniatura de inmediato: están en el pliegue. */
  prioritaria?: boolean;
}

const { material, prioritaria = false } = Astro.props;

const descargable = estaDisponible(material);

const boton =
  'flex h-12 w-full items-center justify-center rounded-full px-6 ' +
  'text-[16px] leading-normal font-semibold ' +
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-morado-600 ' +
  'focus-visible:ring-offset-2';

/**
 * Manito al pasar por encima y rebote mínimo al pulsar. Solo va en el botón
 * activo: el bloqueado es un `<span>` y no debe responder al clic.
 */
const botonActivo =
  'cursor-pointer bg-rosa text-white transition-[opacity,transform] duration-150 ease-out ' +
  'hover:opacity-90 active:scale-[0.97]';

const botonBloqueado = 'cursor-not-allowed bg-borde text-boton-inactivo';
---

<article
  class="flex flex-col gap-4 rounded-2xl border border-borde bg-white p-4 drop-shadow-[0_19px_15.9px_rgba(0,0,0,0.09)] lg:gap-6"
>
  <img
    src={material.miniaturaUrl}
    alt={`Miniatura de ${material.titulo}`}
    width="352"
    height="222"
    loading={prioritaria ? 'eager' : 'lazy'}
    fetchpriority={prioritaria ? 'high' : 'auto'}
    decoding="async"
    class="h-[174px] w-full rounded-xl bg-borde object-cover lg:h-[222px]"
  />

  <div class="flex flex-col gap-2">
    <h2 class="text-[20px] leading-normal font-semibold text-balance text-texto-fuerte">
      {material.titulo}
    </h2>
    {
      material.descripcion && (
        <p class="text-[14px] leading-[20px] text-texto">{material.descripcion}</p>
      )
    }
  </div>

  {
    descargable ? (
      <a
        href={material.materialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[boton, botonActivo]}
      >
        {material.textoBoton}
        <span class="sr-only">
          — material de {material.titulo} (se abre en una pestaña nueva)
        </span>
      </a>
    ) : (
      <span class:list={[boton, botonBloqueado]} aria-disabled="true">
        {material.textoBoton}
        <span class="sr-only">— todavía no disponible</span>
      </span>
    )
  }
</article>
