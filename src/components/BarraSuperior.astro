---
/**
 * Barra superior de la landing. Solo lleva el logo: el diseño del portal
 * anterior incluía además el botón "Cerrar sesión" y el avatar, pero aquí no
 * hay sesión que cerrar.
 */
---

<header class="barra-superior w-full">
  <div class="mx-auto flex h-[72px] w-full max-w-[1200px] items-center px-6 lg:h-20 lg:px-0">
    <img
      src="/img/logo-speakeasy-header.webp"
      alt="Speak Easy"
      width="66"
      height="41"
      class="h-[41px] w-auto drop-shadow-[0_4px_4px_rgba(0,0,0,0.25)]"
      fetchpriority="high"
    />
  </div>
</header>
